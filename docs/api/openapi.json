{"openapi":"3.1.0","info":{"title":"Paynash POS API","version":"v1"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"security":[{"bearer":[]}],"paths":{"/customers/{id}":{"get":{"tags":["Customers"],"summary":"A customer with their invoice history","operationId":"get","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CustomerDetailView"}}}}}},"put":{"tags":["Customers"],"summary":"Edit a customer","description":"Issued invoices keep the details they were issued with.","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomerRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CustomerView"}}}}}}},"/admin/tables/{id}":{"put":{"tags":["Admin: tables"],"summary":"Edit, deactivate, or reactivate a table","description":"Orders already sent keep the number they were sent with.","operationId":"update_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTableRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminTableView"}}}}}},"delete":{"tags":["Admin: tables"],"summary":"Delete a table","description":"Orders already sent keep their table number.","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"No Content"}}}},"/admin/staff/{id}":{"put":{"tags":["Admin: staff"],"summary":"Edit a staff account","description":"Setting active=false ends all its sessions. Role station needs printerIds.","operationId":"update_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateStaffRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StaffView"}}}}}}},"/admin/settings":{"put":{"tags":["Settings"],"summary":"Save the business details and the VAT setting","description":"Street, postal code, and city are required in salon mode. Turning VAT on requires a valid UID (CHE-123.456.789 MWST). The IBAN must be Swiss or Liechtenstein.","operationId":"update_3","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateSettingsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SettingsView"}}}}}}},"/admin/settings/mode":{"put":{"tags":["Settings"],"summary":"Change the installation mode","description":"Only possible while no order exists (409).","operationId":"changeMode","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeModeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SettingsView"}}}}}}},"/admin/printers/{id}":{"put":{"tags":["Admin: printers"],"summary":"Edit, deactivate, or reactivate a printer","description":"Tickets already queued for this printer are still sent to it.","operationId":"update_4","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrinterRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrinterView"}}}}}}},"/admin/items/{id}":{"put":{"tags":["Admin: menu"],"summary":"Edit, deactivate, or reactivate an item","description":"Items are deactivated instead of deleted, so past orders stay intact.","operationId":"updateItem","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ItemRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ItemView"}}}}}}},"/admin/categories/{id}":{"put":{"tags":["Admin: menu"],"summary":"Rename a category","operationId":"renameCategory","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CategoryRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CategoryView"}}}}}},"delete":{"tags":["Admin: menu"],"summary":"Delete an empty category","description":"409 with the item names if the category still contains items.","operationId":"deleteCategory","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"No Content"}}}},"/admin/categories/{id}/items/order":{"put":{"tags":["Admin: menu"],"summary":"Reorder the items of a category","description":"ids must list every item of the category exactly once.","operationId":"reorderItems","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ItemView"}}}}}}}},"/admin/categories/order":{"put":{"tags":["Admin: menu"],"summary":"Reorder categories","description":"ids must list every category exactly once.","operationId":"reorderCategories","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CategoryView"}}}}}}}},"/station/tickets/{id}/resolve":{"post":{"tags":["Station"],"summary":"Resolve an unclear ticket","description":"printed: the ticket was found in the pile; nothing is printed. reprint: it is printed again marked REPRINT and the answer is the reprint. 409 if the ticket is not unclear or was already resolved. Accepts an Idempotency-Key.","operationId":"resolve","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResolveRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketView"}}}}}}},"/station/tickets/{id}/reprint":{"post":{"tags":["Station"],"summary":"Reprint a ticket of an assigned printer","description":"Same as the waiters' reprint. 409 while the ticket is waiting or printing. Accepts an Idempotency-Key.","operationId":"reprint","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketView"}}}}}}},"/station/orders/{id}/void":{"post":{"tags":["Station"],"summary":"Void a sent order, confirmed with a staff PIN","description":"Cancels all remaining lines and prints cancellation tickets. A wrong username or PIN answers 400 with an error on pin and changes nothing. If version is given and the order changed meanwhile, answers 409. Accepts an Idempotency-Key.","operationId":"voidOrder","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfirmedVoidRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/station/orders/{id}/lines/{lineId}/cancel":{"post":{"tags":["Station"],"summary":"Cancel a line of a sent order, confirmed with a staff PIN","description":"Prints a cancellation ticket. A wrong username or PIN answers 400 with an error on pin and changes nothing. Accepts an Idempotency-Key.","operationId":"cancelLine","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"lineId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfirmedCancelRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/orders":{"get":{"tags":["Orders"],"summary":"Order history: orders sent on a day, newest first","description":"date is a local date (Europe/Zurich); defaults to today.","operationId":"history","parameters":[{"name":"date","in":"query","required":false,"schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/OrderSummaryView"}}}}}}},"post":{"tags":["Orders"],"summary":"Send an order","description":"Saves the order as sent and creates the print jobs in the same transaction. In event mode the table label is 1 to 10 letters or digits and stored upper-case. In salon mode the order is confirmed for customerId instead, contains only services, and prints no tickets. Name, type, category, price, and VAT rate are copied from the menu items. 409 with inactiveMenuItemIds or inactiveCustomerId if items or the customer were deactivated; nothing is saved then.","operationId":"send","parameters":[{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SendRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/orders/{orderId}/tickets/{ticketId}/reprint":{"post":{"tags":["Orders"],"summary":"Reprint a ticket","description":"Queues the same content marked REPRINT for the printer that currently serves the ticket's type. Accepts an Idempotency-Key, so a retried request prints once. 409 while the ticket is still pending.","operationId":"reprint_1","parameters":[{"name":"orderId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"ticketId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketView"}}}}}}},"/orders/{orderId}/invoice":{"post":{"tags":["Invoices"],"summary":"Issue the invoice of a confirmed salon order","description":"Accepts an Idempotency-Key header. 409 if business details are missing (missingDetails), the order is voided, has no lines left, or already has an invoice (invoiceId, invoiceNumber).","operationId":"issue","parameters":[{"name":"orderId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InvoiceView"}}}}}}},"/invoices/{id}/receipt":{"post":{"tags":["Invoices"],"summary":"Print the receipt again as a copy","description":"Marked \"KOPIE\" (and \"STORNIERT\" for a cancelled invoice). Also resolves an unclear receipt. 409 while a receipt of the invoice is still waiting or printing.","operationId":"printCopy","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketView"}}}}}}},"/invoices/{id}/payment":{"post":{"tags":["Invoices"],"summary":"Mark an open invoice as paid","description":"paidOn must not be before the invoice date or in the future. 409 if the invoice is cancelled or already paid. Accepts an Idempotency-Key header.","operationId":"pay","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaymentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InvoiceView"}}}}}}},"/customers":{"get":{"tags":["Customers"],"summary":"Search customers","description":"q matches name, email, and customer number ignoring case, and phone numbers on their digits. Lists at most 50 customers by last and first name. includeInactive is for admins only.","operationId":"search","parameters":[{"name":"q","in":"query","required":false,"schema":{"type":"string"}},{"name":"includeInactive","in":"query","required":false,"schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CustomerView"}}}}}}},"post":{"tags":["Customers"],"summary":"Create a customer","description":"First name or last name is required.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomerRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CustomerView"}}}}}}},"/auth/logout":{"post":{"tags":["Auth"],"summary":"End the current session","operationId":"logout","responses":{"204":{"description":"No Content"}}}},"/auth/login":{"post":{"tags":["Auth"],"summary":"Log in with username and PIN","description":"Returns a bearer token valid for 12 hours (24 hours for stations). Any failure answers 401 \"Invalid credentials\".","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}}},"security":[]}},"/admin/tables":{"get":{"tags":["Admin: tables"],"summary":"List all tables, including inactive ones","operationId":"list","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AdminTableView"}}}}}}},"post":{"tags":["Admin: tables"],"summary":"Create a table","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTableRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminTableView"}}}}}}},"/admin/staff":{"get":{"tags":["Admin: staff"],"summary":"List all staff accounts","operationId":"list_1","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/StaffView"}}}}}}},"post":{"tags":["Admin: staff"],"summary":"Create a staff account","description":"Role station needs printerIds: the printers the station shows.","operationId":"create_2","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateStaffRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StaffView"}}}}}}},"/admin/staff/{id}/pin":{"post":{"tags":["Admin: staff"],"summary":"Reset the PIN of a staff account","description":"Also clears a login lockout.","operationId":"resetPin","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResetPinRequest"}}},"required":true},"responses":{"204":{"description":"No Content"}}}},"/admin/printers":{"get":{"tags":["Admin: printers"],"summary":"List all printers","operationId":"list_2","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/PrinterView"}}}}}}},"post":{"tags":["Admin: printers"],"summary":"Add a printer","description":"At most one active printer per type (food or drink).","operationId":"create_3","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrinterRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrinterView"}}}}}}},"/admin/printers/{id}/test":{"post":{"tags":["Admin: printers"],"summary":"Print a test ticket now and report whether it worked","operationId":"testPrint","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TestPrintView"}}}}}}},"/admin/orders/{id}/void":{"post":{"tags":["Admin: orders"],"summary":"Void a sent order","description":"Cancels all remaining lines and prints cancellation tickets for them. A reason is required. If version is given and the order changed meanwhile, answers 409.","operationId":"voidOrder_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VoidRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/admin/orders/{id}/lines/{lineId}/cancel":{"post":{"tags":["Admin: orders"],"summary":"Cancel a line of a sent order","description":"Prints a cancellation ticket. A reason is required.","operationId":"cancelLine_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"lineId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Idempotency-Key","in":"header","description":"Client-generated UUID. A repeated request with the same key within 24 hours returns the stored response without running again.","required":false,"schema":{"type":"string","maxLength":100}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelLineRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/admin/items":{"get":{"tags":["Admin: menu"],"summary":"All items, including inactive ones","operationId":"items","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ItemView"}}}}}}},"post":{"tags":["Admin: menu"],"summary":"Create an item","description":"price is CHF as a string, e.g. \"4.50\". vatRate is one of \"8.1\" (default), \"2.6\", \"3.8\", \"0\". Salon mode accepts only type service, event mode only food and drink.","operationId":"createItem","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ItemRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ItemView"}}}}}}},"/admin/items/{id}/image":{"post":{"tags":["Admin: menu"],"summary":"Upload or replace the item image","description":"JPEG, PNG or WebP up to 5 MB. Stored as WebP, max 512 px.","operationId":"uploadImage","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ItemView"}}}}}},"delete":{"tags":["Admin: menu"],"summary":"Remove the item image","operationId":"removeImage","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ItemView"}}}}}}},"/admin/invoices/{id}/payment/undo":{"post":{"tags":["Invoices"],"summary":"Set a paid invoice back to open","description":"The removed payment stays in paymentHistory with who removed it and why.","operationId":"undoPayment","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReasonRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InvoiceView"}}}}}}},"/admin/invoices/{id}/cancel":{"post":{"tags":["Invoices"],"summary":"Cancel an invoice","description":"The invoice keeps its number and is marked cancelled. 409 if it is paid or already cancelled. The order can then be corrected and invoiced again.","operationId":"cancel","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReasonRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InvoiceView"}}}}}}},"/admin/customers/{id}/reactivate":{"post":{"tags":["Customers"],"summary":"Reactivate a customer","operationId":"reactivate","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CustomerView"}}}}}}},"/admin/customers/{id}/deactivate":{"post":{"tags":["Customers"],"summary":"Deactivate a customer","description":"Inactive customers cannot be picked for new orders.","operationId":"deactivate","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CustomerView"}}}}}}},"/admin/categories":{"get":{"tags":["Admin: menu"],"summary":"All categories in display order","operationId":"categories","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CategoryView"}}}}}}},"post":{"tags":["Admin: menu"],"summary":"Create a category (appended at the end)","operationId":"createCategory","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CategoryRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CategoryView"}}}}}}},"/tables":{"get":{"tags":["Tables"],"summary":"Active tables, sorted by number (\"2\" before \"10\")","operationId":"list_3","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TableView"}}}}}}}},"/station/tickets":{"get":{"tags":["Station"],"summary":"Tickets of an assigned printer","description":"Today's tickets (Europe/Zurich) and every older ticket that still needs attention. Unclear tickets that need a decision come first, then newest first. 403 for a printer the station does not show.","operationId":"tickets","parameters":[{"name":"printerId","in":"query","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/StationTicketView"}}}}}}}},"/station/printers":{"get":{"tags":["Station"],"summary":"The printers this station shows, with status and queue","operationId":"printers","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/StationPrinterView"}}}}}}}},"/station/orders/{id}":{"get":{"tags":["Station"],"summary":"An order with its lines and tickets, to cancel lines or void it from the station","operationId":"order","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/settings":{"get":{"tags":["Settings"],"summary":"Installation mode and business details","description":"Readable by every logged-in user. The apps build their navigation from the mode.","operationId":"get_1","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SettingsView"}}}}}}},"/orders/{id}":{"get":{"tags":["Orders"],"summary":"An order with its lines","operationId":"order_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrderView"}}}}}}},"/menu":{"get":{"tags":["Menu"],"summary":"Active menu for order taking","description":"Supports ETag / If-None-Match: answers 304 when the menu has not changed.","operationId":"menu","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MenuView"}}}}}}},"/invoices":{"get":{"tags":["Invoices"],"summary":"Invoices of a period, newest first","description":"from and to are local dates and default to the current month. status is open, paid, or cancelled. q matches the invoice number or the customer name.","operationId":"list_4","parameters":[{"name":"from","in":"query","required":false,"schema":{"type":"string","format":"date"}},{"name":"to","in":"query","required":false,"schema":{"type":"string","format":"date"}},{"name":"status","in":"query","required":false,"schema":{"type":"string"}},{"name":"q","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/InvoiceSummaryView"}}}}}}}},"/invoices/{id}":{"get":{"tags":["Invoices"],"summary":"An invoice with its lines, VAT, and payments","operationId":"get_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","f