{
    "openapi": "3.1.0",
    "info": {
        "title": "Paynash POS API",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "bearer": []
        }
    ],
    "paths": {
        "/admin/staff/{id}": {
            "put": {
                "tags": [
                    "Admin: staff"
                ],
                "summary": "Edit a staff account",
                "description": "Setting active=false ends all its sessions.",
                "operationId": "update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateStaffRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/StaffView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/items/{id}": {
            "put": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Edit, deactivate, or reactivate an item",
                "description": "Items are deactivated instead of deleted, so past orders stay intact.",
                "operationId": "updateItem",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ItemRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ItemView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/categories/{id}": {
            "put": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Rename a category",
                "operationId": "renameCategory",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CategoryRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryView"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Delete an empty category",
                "description": "409 with the item names if the category still contains items.",
                "operationId": "deleteCategory",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/admin/categories/{id}/items/order": {
            "put": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Reorder the items of a category",
                "description": "ids must list every item of the category exactly once.",
                "operationId": "reorderItems",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ItemView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/categories/order": {
            "put": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Reorder categories",
                "description": "ids must list every category exactly once.",
                "operationId": "reorderCategories",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "End the current session",
                "operationId": "logout",
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log in with username and PIN",
                "description": "Returns a bearer token valid for 12 hours. Any failure answers 401 \"Invalid credentials\".",
                "operationId": "login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/admin/staff": {
            "get": {
                "tags": [
                    "Admin: staff"
                ],
                "summary": "List all staff accounts",
                "operationId": "list",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/StaffView"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Admin: staff"
                ],
                "summary": "Create a staff account",
                "operationId": "create",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateStaffRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/StaffView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/staff/{id}/pin": {
            "post": {
                "tags": [
                    "Admin: staff"
                ],
                "summary": "Reset the PIN of a staff account",
                "description": "Also clears a login lockout.",
                "operationId": "resetPin",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetPinRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/admin/items": {
            "get": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "All items, including inactive ones",
                "operationId": "items",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ItemView"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Create an item",
                "description": "price is CHF as a string, e.g. \"4.50\".",
                "operationId": "createItem",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ItemRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ItemView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/items/{id}/image": {
            "post": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Upload or replace the item image",
                "description": "JPEG, PNG or WebP up to 5 MB. Stored as WebP, max 512 px.",
                "operationId": "uploadImage",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "required": [
                                    "file"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ItemView"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Remove the item image",
                "operationId": "removeImage",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ItemView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/categories": {
            "get": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "All categories in display order",
                "operationId": "categories",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryView"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Admin: menu"
                ],
                "summary": "Create a category (appended at the end)",
                "operationId": "createCategory",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CategoryRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/menu": {
            "get": {
                "tags": [
                    "Menu"
                ],
                "summary": "Active menu for order taking",
                "description": "Supports ETag / If-None-Match: answers 304 when the menu has not changed.",
                "operationId": "menu",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/MenuView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/images/{ref}": {
            "get": {
                "tags": [
                    "Menu"
                ],
                "summary": "Item image (WebP)",
                "operationId": "image",
                "parameters": [
                    {
                        "name": "ref",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "health-controller"
                ],
                "operationId": "health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "The logged-in staff member",
                "operationId": "me",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Me"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "UpdateStaffRequest": {
                "type": "object",
                "properties": {
                    "displayName": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 0
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "waiter"
                        ]
                    },
                    "active": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "active",
                    "displayName",
                    "role"
                ]
            },
            "StaffView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "username": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "waiter"
                        ]
                    },
                    "active": {
                        "type": "boolean"
                    }
                }
            },
            "ItemRequest": {
                "type": "object",
                "properties": {
                    "categoryId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 0
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "food",
                            "drink"
                        ]
                    },
                    "price": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 0
                    },
                    "active": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "categoryId",
                    "name",
                    "price",
                    "type"
                ]
            },
            "ItemView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "categoryId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "food",
                            "drink"
                        ]
                    },
                    "price": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "displayOrder": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "imageUrl": {
                        "type": "string"
                    }
                }
            },
            "CategoryRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 60,
                        "minLength": 0
                    }
                },
                "required": [
                    "name"
                ]
            },
            "CategoryView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "displayOrder": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "OrderRequest": {
                "type": "object",
                "properties": {
                    "ids": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                },
                "required": [
                    "ids"
                ]
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "pin": {
                        "type": "string"
                    }
                },
                "required": [
                    "pin",
                    "username"
                ]
            },
            "LoginResponse": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "expiresAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "staff": {
                        "$ref": "#/components/schemas/Me"
                    }
                }
            },
            "Me": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "username": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "waiter"
                        ]
                    }
                }
            },
            "CreateStaffRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "maxLength": 40,
                        "minLength": 0,
                        "pattern": "[A-Za-z0-9._-]+"
                    },
                    "displayName": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 0
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "waiter"
                        ]
                    },
                    "pin": {
                        "type": "string",
                        "pattern": "\\d{4,8}"
                    }
                },
                "required": [
                    "displayName",
                    "pin",
                    "role",
                    "username"
                ]
            },
            "ResetPinRequest": {
                "type": "object",
                "properties": {
                    "pin": {
                        "type": "string",
                        "pattern": "\\d{4,8}"
                    }
                },
                "required": [
                    "pin"
                ]
            },
            "MenuCategoryView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/MenuItemView"
                        }
                    }
                }
            },
            "MenuItemView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "food",
                            "drink"
                        ]
                    },
                    "price": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "imageUrl": {
                        "type": "string"
                    }
                }
            },
            "MenuView": {
                "type": "object",
                "properties": {
                    "categories": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/MenuCategoryView"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}
