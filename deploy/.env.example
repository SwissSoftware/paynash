# Copy to deploy/.env and adjust. See docs/operations.md.

# Hostname the devices use; must resolve to this server in the LAN (router DNS or mDNS).
POS_HOSTNAME=pos.local
# "internal" = certificate from Caddy's local CA (install its root on the devices),
# or "/certs/fullchain.pem /certs/privkey.pem" for your own certificate in deploy/certs/.
POS_TLS=internal
POS_HTTP_PORT=80
POS_HTTPS_PORT=443

# Database password; choose a long random value before the first start.
POS_DB_PASSWORD=

# Daily backup (task 8.2): local time HH:MM, days to keep, and the target directory.
# Point POS_BACKUP_DIR at external storage (NAS or USB mount) in production.
POS_BACKUP_TIME=03:30
POS_BACKUP_KEEP_DAYS=14
POS_BACKUP_DIR=./backups
